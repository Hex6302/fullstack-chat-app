# Frontend Environment Variables
# Copy this file to .env and update the values

# API Configuration
# For production, set this to your backend URL (e.g., https://your-backend.onrender.com/api)
# For development, leave as localhost or set to http://localhost:5001/api
VITE_API_URL=http://localhost:5001/api

# Socket.IO Configuration
# For production, set this to your backend URL (e.g., https://your-backend.onrender.com)
# For development, leave as localhost or set to http://localhost:5001
VITE_SOCKET_URL=http://localhost:5001

# Note: Vite requires the VITE_ prefix for environment variables to be exposed to the client





