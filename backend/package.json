{
  "name": "backend",
  "version": "1.0.0",
  "description": "Scalable Chat Application Backend",
  "main": "src/index.js",
  "scripts": {
    "dev": "nodemon src/index.js",
    "start": "node src/index.js",
    "start:scalable": "node src/scalableApp.js",
    "start:cluster": "node src/cluster.js",
    "build": "echo 'No build step required for Node.js'",
    "test": "echo 'No tests specified'",
    "docker:build": "docker build -t chat-app .",
    "docker:run": "docker run -p 5001:5001 chat-app",
    "docker:compose": "docker-compose up -d",
    "docker:compose:down": "docker-compose down",
    "k8s:deploy": "kubectl apply -f k8s-deployment.yaml",
    "k8s:delete": "kubectl delete -f k8s-deployment.yaml",
    "monitor": "node -e \"console.log('Monitoring endpoints: http://localhost:5001/api/health, http://localhost:5001/api/queues/stats')\"",
    "benchmark": "echo 'Run load testing with tools like Artillery or k6'"
  },
  "keywords": ["chat", "scalable", "nodejs", "socket.io", "redis", "mongodb"],
  "author": "",
  "type": "module",
  "license": "ISC",
  "dependencies": {
    "@socket.io/redis-adapter": "^8.3.0",
    "bcryptjs": "^2.4.3",
    "bull": "^4.16.5",
    "chat-app": "file:..",
    "cloudinary": "^2.5.1",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-cluster": "^0.0.5",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^8.1.0",
    "express-slow-down": "^3.0.0",
    "express-validator": "^7.2.1",
    "helmet": "^8.1.0",
    "hpp": "^0.2.3",
    "ioredis": "^5.8.1",
    "joi": "^18.0.1",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.8.1",
    "multer": "^2.0.2",
    "redis": "^5.8.3",
    "socket.io": "^4.8.1",
    "xss-clean": "^0.1.4"
  },
  "devDependencies": {
    "nodemon": "^3.1.7"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  }
}
