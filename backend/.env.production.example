# Production Environment Configuration for Render.com
# Copy these values to Render.com environment variables (do NOT commit .env files with real values)

# Server Configuration
NODE_ENV=production
PORT=10000

# Database Configuration (MongoDB Atlas)
# Get this from MongoDB Atlas → Connect → Connect your application
MONGODB_URI=mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/chat-app?retryWrites=true&w=majority

# JWT Configuration
# Generate secure random strings (minimum 32 characters)
JWT_SECRET=your-super-secure-jwt-secret-key-minimum-32-characters-long-change-this
JWT_REFRESH_SECRET=your-super-secure-refresh-secret-key-different-from-jwt-secret-change-this
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# Cookie Configuration
# Set to your frontend domain (e.g., your-app.vercel.app or your-app.netlify.app)
COOKIE_DOMAIN=your-frontend-domain.vercel.app
COOKIE_SECURE=true
COOKIE_SAME_SITE=none

# CORS Configuration
# Add all your frontend URLs separated by commas
# Example: https://your-app.vercel.app,https://your-app.netlify.app
ALLOWED_ORIGINS=https://your-frontend-domain.vercel.app

# Cloudinary Configuration (for image uploads)
# Get these from Cloudinary Dashboard
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Redis Configuration (Optional - Upstash)
# Get these from Upstash Dashboard
# If not using Redis, you can omit these variables
REDIS_HOST=your_upstash_redis_endpoint.upstash.io
REDIS_PORT=6379
REDIS_PASSWORD=your_upstash_redis_password

# Security Configuration
BCRYPT_ROUNDS=12
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_TIME=15
SESSION_TIMEOUT=3600

# Rate Limiting Configuration
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX_REQUESTS=5
MESSAGE_RATE_LIMIT_MAX_REQUESTS=30

# File Upload Configuration
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,image/webp,application/pdf,text/plain

# Logging Configuration
LOG_LEVEL=warn
LOG_SECURITY_EVENTS=true

# Security Headers
SECURITY_HEADERS_ENABLED=true
CSP_ENABLED=true
HSTS_ENABLED=true





